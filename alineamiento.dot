digraph G {
  rankdir=TB;
  node [shape=ellipse, style=filled];
   subgraph cluster_info {
       label="Colores";
       style=dotted;
       node [style=filled, width=0.1, fontsize=3];
       ranksep=0.05;
       A_legend [label="Adenina (A)", shape=ellipse, fillcolor=green];
       T_legend [label="Timina (T)", shape=ellipse, fillcolor=red];
       C_legend [label="Citosina (C)", shape=ellipse, fillcolor=blue];
       G_legend [label="Guanina (G)", shape=ellipse, fillcolor=yellow];
       Match [label="Match", shape=plaintext, color=green];
       Gap [label="Gap", shape=plaintext, color=red];
   }
   A0 [label="-", fillcolor=gray];
   B0 [label="C", fillcolor=blue];
   A0 -> B0 [label="Gap" color=red];
   A1 [label="C", fillcolor=blue];
   B1 [label="C", fillcolor=blue];
   A1 -> B1 [label="Match" color=green];
   A2 [label="A", fillcolor=green];
   B2 [label="A", fillcolor=green];
   A2 -> B2 [label="Match" color=green];
   A3 [label="G", fillcolor=yellow];
   B3 [label="-", fillcolor=gray];
   A3 -> B3 [label="Gap" color=red];
   A4 [label="C", fillcolor=blue];
   B4 [label="-", fillcolor=gray];
   A4 -> B4 [label="Gap" color=red];
   A5 [label="T", fillcolor=red];
   B5 [label="T", fillcolor=red];
   A5 -> B5 [label="Match" color=green];
   A6 [label="A", fillcolor=green];
   B6 [label="A", fillcolor=green];
   A6 -> B6 [label="Match" color=green];
   A7 [label="G", fillcolor=yellow];
   B7 [label="-", fillcolor=gray];
   A7 -> B7 [label="Gap" color=red];
   A8 [label="C", fillcolor=blue];
   B8 [label="C", fillcolor=blue];
   A8 -> B8 [label="Match" color=green];
   A9 [label="G", fillcolor=yellow];
   B9 [label="G", fillcolor=yellow];
   A9 -> B9 [label="Match" color=green];
}
